* {
    font-family: "Poppins", "Symbols Nerd Font Mono", "Font Awesome 6 Free", sans-serif;
    font-size: 14px;
    font-weight: 500;
    border: none;
    border-radius: 0;
    min-height: 0;
    padding: 0;
    margin: 0;
}

window#waybar {
    background: transparent;
    color: #f0ece3;
}

.modules-left > widget > *,
.modules-center > widget > *,
.modules-right > widget > * {
    background: rgba(20, 18, 16, 0.92);
    color: #f0ece3;
    border-radius: 999px;
    padding: 5px 16px;
    margin: 4px 5px;
    border:2px solid rgba(212, 163, 115, 0.4);
    box-shadow: 0 0 12px rgba(212, 163, 115, 0.15), 0 4px 12px rgba(0, 0, 0, 0.5);
}

.modules-left > widget > *:hover,
.modules-right > widget > *:hover {
    background: rgba(40, 35, 30, 0.95);
    border-color: rgba(212, 163, 115, 0.7);
    box-shadow: 0 0 20px rgba(212, 163, 115, 0.25), 0 4px 12px rgba(0, 0, 0, 0.5);
}

#custom-launcher {
    font-size: 18px;
    padding: 6px 22px;
    color: #d4a373;
    border-color: rgba(212, 163, 115, 0.5);
}

#workspaces {
    background: rgba(20, 18, 16, 0.92);
    border-radius: 9999px;
    border: 2px solid rgba(212, 163, 115, 0.3);
    box-shadow: 0 0 12px rgba(212, 163, 115, 0.1), 0 4px 12px rgba(0, 0, 0, 0.5);
    padding: 3px 8px;
    margin: 4px 5px;
}

#workspaces button {
    background: transparent;
    color: #6a6a6a;
    border-radius: 9999px;
    padding: 2px 10px;
    min-width: 24px;
    font-size: 13px;
    margin: 0 2px;
    border: none;
}

#workspaces button.focused {
    background: #d4a373;
    color: #1a1a1a;
    padding: 2px 18px;
    font-weight: 600;
    box-shadow: 0 0 24px rgba(212, 163, 115, 0.3);
}

#workspaces button.active {
    background: #d4a373;
    color: #1a1a1a;
    padding: 2px 18px;
    font-weight: 600;
    box-shadow: 0 0 24px rgba(212, 163, 115, 0.3);
}

#workspaces button.urgent {
    background: #e76f51;
    color: #ffffff;
    box-shadow: 0 0 24px rgba(231, 111, 81, 0.4);
}

#workspaces button:hover {
    background: rgba(212, 163, 115, 0.2);
    color: #f0ece3;
}

#mpris {
    color: #c9b99a;
    font-size: 12px;
}

#clock {
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #f0ece3;
}

#clock#date {
    font-weight: 400;
    color: #a89880;
    font-size: 12px;
}

#network {
    color: #f0ece3;
}

#pulseaudio {
    color: #d4c5b0;
}

#battery {
    color: #d4c5b0;
}

#pulseaudio.muted {
    color: #6a6a6a;
}

#battery.warning {
    color: #e6b85e;
    border-color: rgba(230, 184, 94, 0.5);
    box-shadow: 0 0 20px rgba(230, 184, 94, 0.2);
}

#battery.critical {
    color: #e76f51;
    border-color: rgba(231, 111, 81, 0.5);
    box-shadow: 0 0 20px rgba(231, 111, 81, 0.3);
}

#window {
    background: transparent;
    color: #a89880;
    font-size: 12px;
    padding: 0 8px;
}

tooltip {
    background: rgba(20, 18, 16, 0.96);
    border: 1px solid rgba(212, 163, 115, 0.4);
    border-radius: 16px;
    padding: 16px 20px;
    box-shadow: 0 0 40px rgba(212, 163, 115, 0.1), 0 12px 40px rgba(0, 0, 0, 0.8);
}
